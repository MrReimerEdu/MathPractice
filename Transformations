<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Deep Ocean Transformations</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(to bottom, #071f36 0%, #0a3a60 50%, #041f3a 100%);
            color: #e2e8f0;
            min-height: 100vh;
            overflow-x: hidden;
            margin: 0;
        }

        /* Standard Clean Glass Panels */
        .panel {
            background: rgba(15, 35, 60, 0.85);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 1rem;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        }

        /* Button Styling (Clean, no glow) */
        .btn-primary {
            background-color: #0284c7; /* Tailwind sky-600 */
            color: white;
            transition: all 0.2s;
            border: 1px solid #0369a1;
        }
        .btn-primary:hover:not(:disabled) {
            background-color: #0369a1; /* Tailwind sky-700 */
            transform: translateY(-2px);
        }
        .btn-primary:active:not(:disabled) {
            transform: translateY(0);
        }

        .btn-option {
            background-color: #1e3a5f;
            border: 1px solid #3b82f6;
            color: #f8fafc;
            transition: all 0.2s;
        }
        .btn-option:hover {
            background-color: #2563eb;
            transform: translateY(-2px);
        }

        /* Background Fish Animations */
        #animation-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            pointer-events: none;
            overflow: hidden;
        }

        .fish {
            position: absolute;
            font-size: 2rem;
            white-space: nowrap;
            opacity: 0.4;
            animation-timing-function: linear;
            animation-iteration-count: infinite;
        }

        @keyframes swimRight {
            0% { transform: translateX(-150px) scaleX(-1); }
            100% { transform: translateX(110vw) scaleX(-1); }
        }

        @keyframes swimLeft {
            0% { transform: translateX(110vw); }
            100% { transform: translateX(-150px); }
        }

        /* Animation Pause Utility */
        .paused * {
            animation-play-state: paused !important;
        }

        /* Splash Screen Overlay */
        #splash-screen {
            position: fixed;
            inset: 0;
            background: linear-gradient(to bottom, #04101e, #0a2e4f);
            z-index: 100;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            text-align: center;
            transition: opacity 0.5s ease;
        }

        /* Toast Notifications */
        .toast {
            position: fixed;
            bottom: 20px;
            right: 20px;
            transform: translateX(120%);
            transition: transform 0.3s ease;
            z-index: 50;
        }
        .toast.show {
            transform: translateX(0);
        }

        /* Achievement Modal */
        #achievement-modal {
            transition: opacity 0.3s ease;
        }
    </style>
</head>
<body class="p-4 sm:p-8 flex flex-col items-center">

    <!-- Splash Screen -->
    <div id="splash-screen">
        <div class="max-w-2xl panel p-10 flex flex-col items-center">
            <h1 class="text-4xl font-bold text-sky-400 mb-6">Deep Ocean Transformations</h1>
            <p class="text-xl text-slate-300 italic mb-8 leading-relaxed">
                "Just as the ocean currents shift the sands, every point in the deep must find its new path. Dive in and transform your coordinates."
            </p>
            <button onclick="startApp()" class="btn-primary px-8 py-3 rounded-lg text-lg font-semibold w-full sm:w-auto">
                Start Dive
            </button>
        </div>
    </div>

    <!-- Background Animations -->
    <div id="animation-container"></div>

    <!-- Main App Container (Hidden initially) -->
    <div id="app-container" class="w-full max-w-5xl hidden opacity-0 transition-opacity duration-500">
        
        <!-- Header -->
        <header class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4 panel p-4">
            <h1 class="text-2xl sm:text-3xl font-bold text-sky-300">Transformation Mapping</h1>
            
            <div class="flex flex-wrap gap-2 justify-center items-center">
                <!-- Modes -->
                <button id="btn-standard" class="px-4 py-2 rounded font-medium bg-sky-600 text-white transition-colors" onclick="setMode('standard')">Standard</button>
                <button id="btn-challenge" class="px-4 py-2 rounded font-medium bg-slate-700 text-slate-400 cursor-not-allowed transition-colors" onclick="setMode('challenge')" disabled>Challenge (Locked)</button>
                <button id="btn-game" class="px-4 py-2 rounded font-medium bg-slate-700 text-white hover:bg-slate-600 transition-colors" onclick="setMode('game')">Submarine Dash</button>
                <!-- Freeze Toggle -->
                <div class="w-px h-8 bg-slate-600 mx-2 hidden md:block"></div>
                <button id="freeze-btn" onclick="toggleAnimations()" class="px-4 py-2 rounded font-medium bg-teal-700 hover:bg-teal-600 text-white flex items-center gap-2 border border-teal-500">
                    <span>⏸️</span> Freeze Background
                </button>
            </div>
        </header>

        <!-- Main Layout Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <!-- Left Column: Stats & Guide -->
            <div class="flex flex-col gap-6">
                
                <!-- Stats Panel -->
                <div class="panel p-6 text-center">
                    <div id="streak-container">
                        <h2 class="text-lg text-slate-300 font-medium mb-1">Current Streak</h2>
                        <div class="text-5xl font-bold text-sky-400" id="streak-counter">0</div>
                        <p class="text-sm text-slate-400 mt-2">Highest: <span id="highest-streak">0</span></p>
                    </div>
                    
                    <div id="game-stats-container" class="hidden">
                        <h2 class="text-lg text-slate-300 font-medium mb-1">Time Left</h2>
                        <div class="text-5xl font-bold text-red-400" id="timer-display">60</div>
                        <h3 class="text-lg text-slate-300 mt-4">Score: <span id="game-score" class="text-2xl font-bold text-sky-400">0</span></h3>
                        <button id="start-game-btn" class="mt-4 w-full py-2 bg-emerald-600 hover:bg-emerald-500 rounded font-bold text-white transition-colors" onclick="startGame()">Start Dash</button>
                    </div>
                </div>

                <!-- Reference Guide -->
                <div class="panel p-6 text-sm text-slate-200 h-full">
                    <h3 class="font-bold text-lg text-sky-300 mb-3 border-b border-sky-800 pb-2">Reference Guide</h3>
                    <p class="italic text-xs mb-3 text-sky-200 bg-sky-900/30 p-2 rounded border border-sky-800/50">
                        Referencing: 1a. Transformation Mapping Rules Summary
                    </p>
                    <ul class="space-y-3 list-disc pl-4">
                        <li><strong>Translation:</strong> <br>(x, y) → (x + a, y + b)</li>
                        <li><strong>Reflection (x-axis):</strong> <br>(x, y) → (x, -y)</li>
                        <li><strong>Reflection (y-axis):</strong> <br>(x, y) → (-x, y)</li>
                        <li><strong>Rotation (90° CW origin):</strong> <br>(x, y) → (y, -x)</li>
                        <li><strong>Rotation (180° CW origin):</strong> <br>(x, y) → (-x, -y)</li>
                        <li><strong>Rotation (270° CW origin):</strong> <br>(x, y) → (-y, x)</li>
                    </ul>
                </div>
            </div>

            <!-- Right Column: Question Area -->
            <div class="lg:col-span-2 panel p-6 sm:p-10 flex flex-col justify-between min-h-[450px]">
                <div>
                    <div class="flex justify-between items-center mb-6">
                        <span id="mode-badge" class="px-3 py-1 rounded bg-sky-900/50 text-sky-300 text-xs font-semibold uppercase tracking-wide border border-sky-700">Standard Practice</span>
                        <span id="feedback-icon" class="text-2xl opacity-0 transition-opacity"></span>
                    </div>
                    
                    <h2 id="question-text" class="text-2xl sm:text-3xl font-semibold mb-8 leading-tight text-white">
                        Loading question...
                    </h2>

                    <div id="options-container" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Options injected by JS -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Achievement Modal -->
    <div id="achievement-modal" class="fixed inset-0 bg-black/70 flex items-center justify-center z-50 opacity-0 pointer-events-none">
        <div class="panel p-8 text-center max-w-sm w-full mx-4 transform scale-95 transition-transform duration-300" id="achievement-card">
            <div class="text-5xl mb-4">🏆</div>
            <h2 class="text-2xl font-bold text-amber-400 mb-2" id="achievement-title">Achievement Unlocked!</h2>
            <p class="text-slate-300 mb-6" id="achievement-desc">You've reached a streak of 10!</p>
            <button onclick="closeAchievement()" class="btn-primary px-6 py-2 rounded font-bold w-full">Awesome!</button>
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast" class="toast panel border-l-4 border-l-red-500 p-4 flex items-center gap-3 w-64">
        <span id="toast-icon">❌</span>
        <div id="toast-message" class="font-medium text-slate-100">Wrong Answer!</div>
    </div>

    <script>
        // --- State Management ---
        let state = {
            mode: 'standard', // 'standard', 'challenge', 'game'
            streak: 0,
            highestStreak: 0,
            challengeUnlocked: false,
            score: 0,
            timeLeft: 0,
            timerId: null,
            currentQuestion: null,
            gameActive: false,
            animationsPaused: false
        };

        const DOM = {
            app: document.getElementById('app-container'),
            splash: document.getElementById('splash-screen'),
            streak: document.getElementById('streak-counter'),
            highStreak: document.getElementById('highest-streak'),
            question: document.getElementById('question-text'),
            options: document.getElementById('options-container'),
            toast: document.getElementById('toast'),
            toastMsg: document.getElementById('toast-message'),
            toastIcon: document.getElementById('toast-icon'),
            achModal: document.getElementById('achievement-modal'),
            achCard: document.getElementById('achievement-card'),
            achTitle: document.getElementById('achievement-title'),
            achDesc: document.getElementById('achievement-desc'),
            btnChallenge: document.getElementById('btn-challenge'),
            modeBadge: document.getElementById('mode-badge'),
            streakContainer: document.getElementById('streak-container'),
            gameStatsContainer: document.getElementById('game-stats-container'),
            timerDisplay: document.getElementById('timer-display'),
            gameScore: document.getElementById('game-score'),
            startGameBtn: document.getElementById('start-game-btn'),
            feedbackIcon: document.getElementById('feedback-icon'),
            animContainer: document.getElementById('animation-container'),
            freezeBtn: document.getElementById('freeze-btn')
        };

        // --- Initialization ---
        function startApp() {
            DOM.splash.style.opacity = '0';
            setTimeout(() => {
                DOM.splash.style.display = 'none';
                DOM.app.classList.remove('hidden');
                setTimeout(() => DOM.app.classList.remove('opacity-0'), 50);
            }, 500);
            spawnFish(8);
            generateQuestion();
        }

        // --- Background Animations ---
        function spawnFish(count) {
            const fishTypes = ['🐟', '🐡', '🦈', '🐠'];
            for(let i=0; i<count; i++) {
                let f = document.createElement('div');
                f.className = 'fish';
                f.innerText = fishTypes[Math.floor(Math.random() * fishTypes.length)];
                
                // Random properties
                let isRight = Math.random() > 0.5;
                f.style.top = `${Math.random() * 80 + 10}vh`; // 10% to 90% vertical
                f.style.animationName = isRight ? 'swimRight' : 'swimLeft';
                f.style.animationDuration = `${Math.random() * 20 + 15}s`; // 15-35 seconds
                f.style.animationDelay = `-${Math.random() * 15}s`; // Start randomly in the cycle
                f.style.fontSize = `${Math.random() * 1.5 + 1.5}rem`;
                
                DOM.animContainer.appendChild(f);
            }
        }

        function toggleAnimations() {
            state.animationsPaused = !state.animationsPaused;
            if (state.animationsPaused) {
                DOM.animContainer.classList.add('paused');
                DOM.freezeBtn.innerHTML = '<span>▶️</span> Resume Background';
                DOM.freezeBtn.classList.replace('bg-teal-700', 'bg-amber-600');
                DOM.freezeBtn.classList.replace('hover:bg-teal-600', 'hover:bg-amber-500');
                DOM.freezeBtn.classList.replace('border-teal-500', 'border-amber-500');
            } else {
                DOM.animContainer.classList.remove('paused');
                DOM.freezeBtn.innerHTML = '<span>⏸️</span> Freeze Background';
                DOM.freezeBtn.classList.replace('bg-amber-600', 'bg-teal-700');
                DOM.freezeBtn.classList.replace('hover:bg-amber-500', 'hover:bg-teal-600');
                DOM.freezeBtn.classList.replace('border-amber-500', 'border-teal-500');
            }
        }

        // --- Core Logic ---
        function setMode(mode) {
            if (mode === 'challenge' && !state.challengeUnlocked) return;
            
            if (state.mode === 'game' && state.gameActive) {
                endGame(false);
            }

            state.mode = mode;
            
            // UI Button Updates
            ['standard', 'challenge', 'game'].forEach(m => {
                let btn = document.getElementById(`btn-${m}`);
                if (m === mode) {
                    btn.className = "px-4 py-2 rounded font-medium bg-sky-600 text-white transition-colors";
                } else {
                    if (m === 'challenge' && !state.challengeUnlocked) return; // Keep locked style
                    btn.className = "px-4 py-2 rounded font-medium bg-slate-700 text-white hover:bg-slate-600 transition-colors";
                }
            });

            DOM.modeBadge.innerText = mode === 'standard' ? 'Standard Practice' : 
                                      mode === 'challenge' ? 'Challenge Mode' : 'Submarine Dash';

            if (mode === 'game') {
                DOM.streakContainer.classList.add('hidden');
                DOM.gameStatsContainer.classList.remove('hidden');
                DOM.options.innerHTML = '';
                DOM.question.innerText = "Ready for the 60-second dash? Click start below!";
            } else {
                DOM.streakContainer.classList.remove('hidden');
                DOM.gameStatsContainer.classList.add('hidden');
                generateQuestion();
            }
        }

        // --- Question Generation Engine ---
        function generateQuestion() {
            let point, qType, ans, desc;
            
            if (state.mode === 'standard' || (state.mode === 'game' && Math.random() > 0.3)) {
                // Standard Logic (Integers)
                let x = getRandomInt(-10, 10);
                let y = getRandomInt(-10, 10);
                point = {x, y};
                qType = getRandomInt(0, 5);
                
                switch(qType) {
                    case 0: // Translation
                        let dx = getRandomInt(-5, 5);
                        let dy = getRandomInt(-5, 5);
                        desc = `Translate the point (${x}, ${y}) using mapping rule (x + ${dx}, y + ${dy}).`;
                        ans = {x: x + dx, y: y + dy};
                        break;
                    case 1: // Ref x-axis
                        desc = `Reflect the point (${x}, ${y}) over the x-axis.`;
                        ans = {x: x, y: -y};
                        break;
                    case 2: // Ref y-axis
                        desc = `Reflect the point (${x}, ${y}) over the y-axis.`;
                        ans = {x: -x, y: y};
                        break;
                    case 3: // Rot 90 CW
                        desc = `Rotate the point (${x}, ${y}) 90° clockwise around the origin.`;
                        ans = {x: y, y: -x};
                        break;
                    case 4: // Rot 180 CW
                        desc = `Rotate the point (${x}, ${y}) 180° clockwise around the origin.`;
                        ans = {x: -x, y: -y};
                        break;
                    case 5: // Rot 270 CW
                        desc = `Rotate the point (${x}, ${y}) 270° clockwise around the origin.`;
                        ans = {x: -y, y: x};
                        break;
                }
            } else {
                // Challenge Logic (Decimals & Lines)
                let x = parseFloat((Math.random() * 20 - 10).toFixed(1));
                let y = parseFloat((Math.random() * 20 - 10).toFixed(1));
                point = {x, y};
                qType = getRandomInt(0, 3);
                
                switch(qType) {
                    case 0: // Ref x = k
                        let kx = getRandomInt(-5, 5);
                        desc = `Reflect the point (${x}, ${y}) over the vertical line x = ${kx}.`;
                        ans = {x: fixFloat(2 * kx - x), y: y};
                        break;
                    case 1: // Ref y = k
                        let ky = getRandomInt(-5, 5);
                        desc = `Reflect the point (${x}, ${y}) over the horizontal line y = ${ky}.`;
                        ans = {x: x, y: fixFloat(2 * ky - y)};
                        break;
                    case 2: // Rot 90 CW about (a,b)
                        let a = getRandomInt(-3, 3);
                        let b = getRandomInt(-3, 3);
                        desc = `Rotate point (${x}, ${y}) 90° clockwise around the point (${a}, ${b}).`;
                        ans = {x: fixFloat(y - b + a), y: fixFloat(-x + a + b)};
                        break;
                    case 3: // Translation with decimals
                        let dx = parseFloat((Math.random() * 10 - 5).toFixed(1));
                        let dy = parseFloat((Math.random() * 10 - 5).toFixed(1));
                        desc = `Translate the point (${x}, ${y}) using mapping rule (x + ${dx}, y + ${dy}).`;
                        ans = {x: fixFloat(x + dx), y: fixFloat(y + dy)};
                        break;
                }
            }

            let options = generateDistractors(ans, point, qType);
            
            state.currentQuestion = { desc, options, ans };
            renderQuestion();
        }

        function generateDistractors(correct, original, type) {
            let opts = new Set();
            opts.add(formatPoint(correct));
            
            // Common grade 8 mistakes
            let pool = [
                {x: correct.x, y: -correct.y}, // missed y sign
                {x: -correct.x, y: correct.y}, // missed x sign
                {x: -correct.x, y: -correct.y}, // opposite both signs
                {x: correct.y, y: correct.x}, // swapped coordinates
                {x: -correct.y, y: correct.x}, // swapped + missed sign
                {x: correct.y, y: -correct.x}, 
            ];

            let isDecimal = !Number.isInteger(correct.x) || !Number.isInteger(correct.y);

            let i = 0;
            while (opts.size < 5 && i < pool.length) {
                let p = pool[i];
                p.x = fixFloat(p.x);
                p.y = fixFloat(p.y);
                opts.add(formatPoint(p));
                i++;
            }

            // Fill remainder with close randoms
            while (opts.size < 5) {
                let rx = correct.x + (isDecimal ? getRandomFloat(-2, 2) : getRandomInt(-2, 2));
                let ry = correct.y + (isDecimal ? getRandomFloat(-2, 2) : getRandomInt(-2, 2));
                opts.add(formatPoint({x: fixFloat(rx), y: fixFloat(ry)}));
            }

            return shuffleArray(Array.from(opts).slice(0, 5));
        }

        function renderQuestion() {
            DOM.question.innerText = state.currentQuestion.desc;
            DOM.options.innerHTML = '';
            
            state.currentQuestion.options.forEach((optStr) => {
                let btn = document.createElement('button');
                btn.className = "btn-option w-full py-4 px-6 rounded-lg text-lg sm:text-xl font-semibold shadow";
                btn.innerText = optStr;
                btn.onclick = () => handleAnswer(optStr);
                DOM.options.appendChild(btn);
            });
        }

        function handleAnswer(selectedOpt) {
            let correctOpt = formatPoint(state.currentQuestion.ans);
            let isCorrect = selectedOpt === correctOpt;

            showFeedbackIcon(isCorrect);

            if (state.mode === 'game') {
                if (isCorrect) {
                    state.score += 10;
                    DOM.gameScore.innerText = state.score;
                } else {
                    state.score = Math.max(0, state.score - 5);
                    DOM.gameScore.innerText = state.score;
                    showToast("Wrong Answer! -5 Points.", false);
                }
                if (state.gameActive) generateQuestion();
            } else {
                if (isCorrect) {
                    state.streak++;
                    if (state.streak > state.highestStreak) state.highestStreak = state.streak;
                    DOM.streak.innerText = state.streak;
                    DOM.highStreak.innerText = state.highestStreak;
                    
                    checkAchievements();
                    generateQuestion();
                } else {
                    state.streak = 0;
                    DOM.streak.innerText = state.streak;
                    showToast("Incorrect! Streak reset to 0.", false);
                    generateQuestion();
                }
            }
        }

        function checkAchievements() {
            if (state.streak === 10 && !state.challengeUnlocked) {
                state.challengeUnlocked = true;
                DOM.btnChallenge.disabled = false;
                DOM.btnChallenge.innerText = 'Challenge Mode';
                DOM.btnChallenge.className = "px-4 py-2 rounded font-medium bg-slate-700 text-white hover:bg-slate-600 transition-colors";
                
                triggerAchievement("Challenge Mode Unlocked!", "10 in a row! You're ready for deeper waters.");
                setTimeout(() => setMode('challenge'), 3000);
            } else if (state.streak === 20) {
                triggerAchievement("Ocean Master!", "20 correct in a row. Incredible precision!");
            } else if (state.streak === 50) {
                triggerAchievement("Poseidon's Calculator!", "50 streak! You have mastered transformations!");
            }
        }

        // --- Game Mode Logic ---
        function startGame() {
            state.gameActive = true;
            state.score = 0;
            state.timeLeft = 60;
            DOM.gameScore.innerText = state.score;
            DOM.timerDisplay.innerText = state.timeLeft;
            DOM.startGameBtn.classList.add('hidden');
            
            generateQuestion();
            
            state.timerId = setInterval(() => {
                state.timeLeft--;
                DOM.timerDisplay.innerText = state.timeLeft;
                if (state.timeLeft <= 0) {
                    endGame(true);
                }
            }, 1000);
        }

        function endGame(timeUp) {
            state.gameActive = false;
            clearInterval(state.timerId);
            DOM.options.innerHTML = '';
            DOM.startGameBtn.classList.remove('hidden');
            DOM.startGameBtn.innerText = "Play Again";
            
            if (timeUp) {
                DOM.question.innerText = `Time's up! Final Score: ${state.score}`;
            } else {
                DOM.question.innerText = "Game Aborted. Click Start to try again.";
            }
        }

        // --- UI Feedback Effects ---
        function triggerAchievement(title, desc) {
            DOM.achTitle.innerText = title;
            DOM.achDesc.innerText = desc;
            DOM.achModal.classList.remove('opacity-0', 'pointer-events-none');
            DOM.achCard.classList.remove('scale-95');
            DOM.achCard.classList.add('scale-100');
        }

        function closeAchievement() {
            DOM.achModal.classList.add('opacity-0', 'pointer-events-none');
            DOM.achCard.classList.remove('scale-100');
            DOM.achCard.classList.add('scale-95');
        }

        function showToast(msg, isSuccess) {
            DOM.toastMsg.innerText = msg;
            DOM.toastIcon.innerText = isSuccess ? "✅" : "❌";
            DOM.toast.className = `toast panel border-l-4 p-4 flex items-center gap-3 w-64 ${isSuccess ? 'border-l-green-500' : 'border-l-red-500'}`;
            DOM.toast.classList.add('show');
            setTimeout(() => {
                DOM.toast.classList.remove('show');
            }, 3000);
        }

        function showFeedbackIcon(isCorrect) {
            DOM.feedbackIcon.innerText = isCorrect ? "✅" : "❌";
            DOM.feedbackIcon.style.opacity = '1';
            DOM.feedbackIcon.style.transform = 'scale(1.3)';
            setTimeout(() => {
                DOM.feedbackIcon.style.opacity = '0';
                DOM.feedbackIcon.style.transform = 'scale(1)';
            }, 800);
        }

        // --- Math Helpers ---
        function getRandomInt(min, max) {
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }
        function getRandomFloat(min, max) {
            return parseFloat((Math.random() * (max - min) + min).toFixed(1));
        }
        function fixFloat(num) {
            let fixed = parseFloat(num.toFixed(1));
            return fixed === 0 ? 0 : fixed;
        }
        function formatPoint(p) {
            return `(${p.x}, ${p.y})`;
        }
        function shuffleArray(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
            return array;
        }
    </script>

        /* =========================================================================
           4. QUESTION GENERATION ENGINE (Standard & Challenge)
           ========================================================================= */

        /**
         * Ensures exactly 5 unique formatted coordinate strings.
         * Uses logical distractors first, then nudges coordinates if any collide.
         */
        function buildUniqueOptions(correctX, correctY, logicalDistractors, isDecimalMode) {
            const correctStr = formatPoint(correctX, correctY);
            const optionSet = new Set([correctStr]);

            for (const d of logicalDistractors) {
                if (optionSet.size >= 5) break;
                const str = formatPoint(d.x, d.y);
                if (!optionSet.has(str)) {
                    optionSet.add(str);
                }
            }

            // Fallback nudging loop if collisions occurred
            const step = isDecimalMode ? 0.5 : 1;
            const nudges = [
                [step, 0], [-step, 0], [0, step], [0, -step],
                [step, step], [-step, -step], [step, -step], [-step, step],
                [step * 2, 0], [-step * 2, 0], [0, step * 2], [0, -step * 2]
            ];

            let nudgeIdx = 0;
            while (optionSet.size < 5 && nudgeIdx < nudges.length) {
                const [nx, ny] = nudges[nudgeIdx++];
                const str = formatPoint(correctX + nx, correctY + ny);
                if (!optionSet.has(str)) {
                    optionSet.add(str);
                }
            }

            return {
                correctStr,
                options: shuffle(Array.from(optionSet))
            };
        }

        /**
         * Standard Mode Question Generator (Grade 8 Mapping Rules)
         */
        function generateStandardQuestion() {
            const types = ['translation', 'reflectX', 'reflectY', 'rot90', 'rot180', 'rot270'];
            const type = pickRandom(types);

            if (type === 'translation') {
                const x = randInt(-9, 9);
                const y = randInt(-9, 9);
                // Strictly non-zero horizontal AND vertical shifts
                const dx = randNonZeroInt(8);
                const dy = randNonZeroInt(8);

                const ansX = cleanNum(x + dx);
                const ansY = cleanNum(y + dy);

                const horizText = dx > 0
                    ? `${dx} ${dx === 1 ? 'unit' : 'units'} to the right`
                    : `${Math.abs(dx)} ${Math.abs(dx) === 1 ? 'unit' : 'units'} to the left`;
                const vertText = dy > 0
                    ? `${dy} ${dy === 1 ? 'unit' : 'units'} up`
                    : `${Math.abs(dy)} ${Math.abs(dy) === 1 ? 'unit' : 'units'} down`;

                const prompt = `Translate the point ${formatPoint(x, y)} ${horizText} and ${vertText}.`;
                const rule = `Mapping rule: (x, y) → (${formatShiftExpr('x', dx)}, ${formatShiftExpr('y', dy)})`;
                const steps = `(${x} ${dx >= 0 ? '+' : '−'} ${Math.abs(dx)}, ${y} ${dy >= 0 ? '+' : '−'} ${Math.abs(dy)}) = ${formatPoint(ansX, ansY)}`;

                const distractors = [
                    { x: x - dx, y: y + dy }, // wrong horizontal direction
                    { x: x + dx, y: y - dy }, // wrong vertical direction
                    { x: x - dx, y: y - dy }, // both directions reversed
                    { x: x + dy, y: y + dx }, // swapped dx and dy
                    { x: ansY, y: ansX }      // swapped final coordinates
                ];

                const { correctStr, options } = buildUniqueOptions(ansX, ansY, distractors, false);
                return { typeLabel: 'Translation', prompt, rule, steps, correctStr, options };
            }

            // For Reflections and Rotations: pick non-zero x, y with |x| !== |y|
            let x = randNonZeroInt(9);
            let y = randNonZeroInt(9);
            while (Math.abs(x) === Math.abs(y)) {
                y = randNonZeroInt(9);
            }

            if (type === 'reflectX') {
                const ansX = x, ansY = -y;
                const prompt = `Reflect the point ${formatPoint(x, y)} over the x-axis.`;
                const rule = `Mapping rule (x-axis reflection): (x, y) → (x, −y)`;
                const steps = `Keep x = ${x}, negate y → ${formatPoint(ansX, ansY)}`;
                const distractors = [
                    { x: -x, y: y },   // reflected over y-axis instead
                    { x: -x, y: -y },  // negated both
                    { x: y, y: x },    // swapped
                    { x: y, y: -x },   // 90° CW rotation
                    { x: -y, y: x }    // 270° CW rotation
                ];
                const { correctStr, options } = buildUniqueOptions(ansX, ansY, distractors, false);
                return { typeLabel: 'Reflection (x-axis)', prompt, rule, steps, correctStr, options };
            }

            if (type === 'reflectY') {
                const ansX = -x, ansY = y;
                const prompt = `Reflect the point ${formatPoint(x, y)} over the y-axis.`;
                const rule = `Mapping rule (y-axis reflection): (x, y) → (−x, y)`;
                const steps = `Negate x, keep y = ${y} → ${formatPoint(ansX, ansY)}`;
                const distractors = [
                    { x: x, y: -y },   // reflected over x-axis instead
                    { x: -x, y: -y },  // negated both
                    { x: y, y: x },    // swapped
                    { x: -y, y: x },   // 270° CW rotation
                    { x: y, y: -x }    // 90° CW rotation
                ];
                const { correctStr, options } = buildUniqueOptions(ansX, ansY, distractors, false);
                return { typeLabel: 'Reflection (y-axis)', prompt, rule, steps, correctStr, options };
            }

            if (type === 'rot90') {
                const ansX = y, ansY = -x;
                const prompt = `Rotate the point ${formatPoint(x, y)} 90° clockwise around the origin.`;
                const rule = `Mapping rule (90° CW): (x, y) → (y, −x)`;
                const steps = `Swap and negate the original x: (${y}, −(${x})) = ${formatPoint(ansX, ansY)}`;
                const distractors = [
                    { x: -y, y: x },   // 270° CW / 90° CCW
                    { x: -x, y: -y },  // 180°
                    { x: y, y: x },    // forgot negative sign
                    { x: -y, y: -x },  // negated both after swap
                    { x: x, y: -y }    // x-axis reflection
                ];
                const { correctStr, options } = buildUniqueOptions(ansX, ansY, distractors, false);
                return { typeLabel: 'Rotation 90° CW', prompt, rule, steps, correctStr, options };
            }

            if (type === 'rot180') {
                const ansX = -x, ansY = -y;
                const prompt = `Rotate the point ${formatPoint(x, y)} 180° clockwise around the origin.`;
                const rule = `Mapping rule (180° CW): (x, y) → (−x, −y)`;
                const steps = `Negate both coordinates: (−(${x}), −(${y})) = ${formatPoint(ansX, ansY)}`;
                const distractors = [
                    { x: x, y: -y },   // only negated y
                    { x: -x, y: y },   // only negated x
                    { x: y, y: -x },   // 90° CW
                    { x: -y, y: x },   // 270° CW
                    { x: -y, y: -x }   // swapped and negated
                ];
                const { correctStr, options } = buildUniqueOptions(ansX, ansY, distractors, false);
                return { typeLabel: 'Rotation 180° CW', prompt, rule, steps, correctStr, options };
            }

            // rot270
            const ansX = -y, ansY = x;
            const prompt = `Rotate the point ${formatPoint(x, y)} 270° clockwise around the origin.`;
            const rule = `Mapping rule (270° CW): (x, y) → (−y, x)`;
            const steps = `Swap and negate the original y: (−(${y}), ${x}) = ${formatPoint(ansX, ansY)}`;
            const distractors = [
                { x: y, y: -x },   // 90° CW
                { x: -x, y: -y },  // 180°
                { x: y, y: x },    // forgot negative sign
                { x: -y, y: -x },  // negated both after swap
                { x: -x, y: y }    // y-axis reflection
            ];
            const { correctStr, options } = buildUniqueOptions(ansX, ansY, distractors, false);
            return { typeLabel: 'Rotation 270° CW', prompt, rule, steps, correctStr, options };
        }

        /**
         * Challenge Mode Question Generator (Decimals, Non-Origin Rotations, Non-Axis Reflections)
         */
        function generateChallengeQuestion() {
            const types = ['translation', 'reflectLineX', 'reflectLineY', 'rotPoint'];
            const type = pickRandom(types);

            if (type === 'translation') {
                const x = randHalfStep(8);
                const y = randHalfStep(8);
                const dx = randNonZeroHalfStep(5.5);
                const dy = randNonZeroHalfStep(5.5);

                const ansX = cleanNum(x + dx);
                const ansY = cleanNum(y + dy);

                const horizText = dx > 0 ? `${dx} units to the right` : `${Math.abs(dx)} units to the left`;
                const vertText = dy > 0 ? `${dy} units up` : `${Math.abs(dy)} units down`;

                const prompt = `Translate the point ${formatPoint(x, y)} ${horizText} and ${vertText}.`;
                const rule = `Mapping rule: (x, y) → (${formatShiftExpr('x', dx)}, ${formatShiftExpr('y', dy)})`;
                const steps = `(${x} ${dx >= 0 ? '+' : '−'} ${Math.abs(dx)}, ${y} ${dy >= 0 ? '+' : '−'} ${Math.abs(dy)}) = ${formatPoint(ansX, ansY)}`;

                const distractors = [
                    { x: x - dx, y: y + dy },
                    { x: x + dx, y: y - dy },
                    { x: x - dx, y: y - dy },
                    { x: x + dy, y: y + dx },
                    { x: ansX + 0.5, y: ansY - 0.5 }
                ];

                const { correctStr, options } = buildUniqueOptions(ansX, ansY, distractors, true);
                return { typeLabel: 'Challenge Translation', prompt, rule, steps, correctStr, options };
            }

            if (type === 'reflectLineX') {
                const c = randNonZeroHalfStep(4); // c !== 0
                let x = randHalfStep(8);
                while (cleanNum(x) === cleanNum(c)) {
                    x = randHalfStep(8);
                }
                const y = randHalfStep(8);

                const ansX = cleanNum(2 * c - x);
                const ansY = cleanNum(y);

                const prompt = `Reflect the point ${formatPoint(x, y)} over the vertical line x = ${c}.`;
                const rule = `Mapping rule (over x = ${c}): (x, y) → (2(${c}) − x, y)`;
                const steps = `x' = ${cleanNum(2 * c)} − (${x}) = ${ansX}, y' = ${ansY} → ${formatPoint(ansX, ansY)}`;

                const distractors = [
                    { x: -x, y: y },            // reflected over y-axis instead
                    { x: c - x, y: y },         // forgot factor of 2
                    { x: x, y: 2 * c - y },     // reflected over y = c instead
                    { x: -x + c, y: y },        // added c once
                    { x: ansX, y: -y }          // also negated y
                ];

                const { correctStr, options } = buildUniqueOptions(ansX, ansY, distractors, true);
                return { typeLabel: `Reflection (x = ${c})`, prompt, rule, steps, correctStr, options };
            }

            if (type === 'reflectLineY') {
                const c = randNonZeroHalfStep(4); // c !== 0
                const x = randHalfStep(8);
                let y = randHalfStep(8);
                while (cleanNum(y) === cleanNum(c)) {
                    y = randHalfStep(8);
                }

                const ansX = cleanNum(x);
                const ansY = cleanNum(2 * c - y);

                const prompt = `Reflect the point ${formatPoint(x, y)} over the horizontal line y = ${c}.`;
                const rule = `Mapping rule (over y = ${c}): (x, y) → (x, 2(${c}) − y)`;
                const steps = `x' = ${ansX}, y' = ${cleanNum(2 * c)} − (${y}) = ${ansY} → ${formatPoint(ansX, ansY)}`;

                const distractors = [
                    { x: x, y: -y },            // reflected over x-axis instead
                    { x: x, y: c - y },         // forgot factor of 2
                    { x: 2 * c - x, y: y },     // reflected over x = c instead
                    { x: x, y: -y + c },        // added c once
                    { x: -x, y: ansY }          // also negated x
                ];

                const { correctStr, options } = buildUniqueOptions(ansX, ansY, distractors, true);
                return { typeLabel: `Reflection (y = ${c})`, prompt, rule, steps, correctStr, options };
            }

            // Rotation (90°, 180°, 270° CW) around non-origin point (h, k)
            let h = randHalfStep(3);
            let k = randHalfStep(3);
            while (h === 0 && k === 0) {
                h = randNonZeroHalfStep(3);
            }

            let x = randHalfStep(7);
            let y = randHalfStep(7);
            while (
                cleanNum(x) === cleanNum(h) ||
                cleanNum(y) === cleanNum(k) ||
                cleanNum(Math.abs(x - h)) === cleanNum(Math.abs(y - k))
            ) {
                x = randHalfStep(7);
                y = randHalfStep(7);
            }

            const dx = cleanNum(x - h);
            const dy = cleanNum(y - k);
            const angle = pickRandom([90, 180, 270]);

            let rotDx, rotDy, rule;
            if (angle === 90) {
                rotDx = dy;
                rotDy = -dx;
                rule = `Shift by (−h, −k), apply 90° CW (dx, dy) → (dy, −dx), then add (h, k)`;
            } else if (angle === 180) {
                rotDx = -dx;
                rotDy = -dy;
                rule = `Shift by (−h, −k), apply 180° CW (dx, dy) → (−dx, −dy), then add (h, k)`;
            } else {
                rotDx = -dy;
                rotDy = dx;
                rule = `Shift by (−h, −k), apply 270° CW (dx, dy) → (−dy, dx), then add (h, k)`;
            }

            const ansX = cleanNum(rotDx + h);
            const ansY = cleanNum(rotDy + k);

            const prompt = `Rotate the point ${formatPoint(x, y)} ${angle}° clockwise around the point ${formatPoint(h, k)}.`;
            const steps = `Relative vector: (${dx}, ${dy}) → rotated: (${cleanNum(rotDx)}, ${cleanNum(rotDy)}) → add ${formatPoint(h, k)} = ${formatPoint(ansX, ansY)}`;

            const distractors = [
                { x: dy + h, y: -dx + k },   // 90° CW around (h,k)
                { x: -dx + h, y: -dy + k },  // 180° CW around (h,k)
                { x: -dy + h, y: dx + k },   // 270° CW around (h,k)
                { x: y, y: -x },             // rotated around origin instead
                { x: -x, y: -y },            // 180° around origin
                { x: rotDx - h, y: rotDy - k } // subtracted (h,k) instead of adding
            ];

            const { correctStr, options } = buildUniqueOptions(ansX, ansY, distractors, true);
            return { typeLabel: `Challenge Rotation ${angle}° CW`, prompt, rule, steps, correctStr, options };
        }

        /* =========================================================================
           5. UI RENDERING & INTERACTION FLOW
           ========================================================================= */

        function startApp() {
            const splash = document.getElementById('splash-screen');
            const shell = document.getElementById('app-shell');
            splash.style.opacity = '0';
            setTimeout(() => {
                splash.style.display = 'none';
                shell.classList.remove('hidden');
                requestAnimationFrame(() => shell.classList.remove('opacity-0'));
            }, 450);

            initOceanBackground();
            loadNewQuestion();
        }

        function switchMode(newMode) {
            if (newMode === 'challenge' && !state.challengeUnlocked) return;

            // Stop active game if leaving game mode
            if (state.mode === 'game' && state.gameActive && newMode !== 'game') {
                stopSubmarineDash(false);
            }

            state.mode = newMode;
            state.awaitingNext = false;

            // Update tab styles
            const tabs = {
                standard: document.getElementById('tab-standard'),
                challenge: document.getElementById('tab-challenge'),
                game: document.getElementById('tab-game')
            };

            Object.entries(tabs).forEach(([key, btn]) => {
                if (key === 'challenge' && !state.challengeUnlocked) return;
                if (key === newMode) {
                    btn.className = 'px-3.5 py-2 rounded-lg text-sm font-semibold bg-sky-600 text-white transition-colors';
                } else {
                    btn.className = 'px-3.5 py-2 rounded-lg text-sm font-semibold bg-slate-800 text-slate-200 hover:bg-slate-700 transition-colors';
                }
            });

            const practicePanel = document.getElementById('practice-stats-panel');
            const gamePanel = document.getElementById('game-stats-panel');
            const modeBadge = document.getElementById('mode-badge');
            const tipText = document.getElementById('mode-tip-text');

            hideFeedback();

            if (newMode === 'game') {
                practicePanel.classList.add('hidden');
                gamePanel.classList.remove('hidden');
                modeBadge.textContent = 'Submarine Dash';
                tipText.textContent = 'Answer quickly and accurately to dive deeper and build your combo multiplier. Wrong answers cost 3 seconds!';
                renderGameReadyState();
            } else {
                practicePanel.classList.remove('hidden');
                gamePanel.classList.add('hidden');
                if (newMode === 'standard') {
                    modeBadge.textContent = 'Standard Practice';
                    tipText.textContent = 'In Standard Mode, apply the mapping rule carefully to both coordinates. Watch your negative signs when rotating clockwise around the origin!';
                } else {
                    modeBadge.textContent = 'Challenge Mode';
                    tipText.textContent = 'Challenge Mode introduces 0.5 decimals, reflections over x = c or y = c, and rotations around non-origin points (h, k).';
                }
                loadNewQuestion();
            }
        }

        function loadNewQuestion() {
            state.awaitingNext = false;
            hideFeedback();

            if (state.mode === 'challenge') {
                state.currentQuestion = generateChallengeQuestion();
            } else if (state.mode === 'game') {
                // Mix standard (75%) and challenge (25%) in Submarine Dash
                state.currentQuestion = Math.random() < 0.75
                    ? generateStandardQuestion()
                    : generateChallengeQuestion();
            } else {
                state.currentQuestion = generateStandardQuestion();
            }

            renderQuestion(state.currentQuestion);
        }

        function renderQuestion(q) {
            document.getElementById('question-type-badge').textContent = q.typeLabel;
            document.getElementById('question-prompt').textContent = q.prompt;
            document.getElementById('question-subtext').textContent = 'Choose the correct image point from the 5 options below.';

            const grid = document.getElementById('options-grid');
            grid.innerHTML = '';

            q.options.forEach((optStr, idx) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'option-btn w-full py-4 px-5 rounded-xl text-lg font-semibold text-left flex items-center justify-between';
                btn.dataset.option = optStr;
                btn.innerHTML = `
                    <span class="text-xs font-bold uppercase tracking-wider text-sky-400/80 mr-3">${String.fromCharCode(65 + idx)}</span>
                    <span class="flex-1 text-center font-bold tracking-wide">${optStr}</span>
                    <span class="w-5"></span>
                `;
                btn.onclick = () => handleOptionSelect(optStr, btn);
                grid.appendChild(btn);
            });
        }

        function handleOptionSelect(selectedOptionString, clickedBtn) {
            if (state.mode !== 'game' && state.awaitingNext) return;
            if (state.mode === 'game' && !state.gameActive) return;

            const q = state.currentQuestion;
            // Strict string comparison — eliminates index/duplicate mismatch bugs
            const isCorrect = selectedOptionString === q.correctStr;

            if (state.mode === 'game') {
                handleGameAnswer(isCorrect);
                return;
            }

            // Practice / Challenge Mode
            state.awaitingNext = true;

            const buttons = document.querySelectorAll('#options-grid button');
            buttons.forEach(btn => {
                btn.disabled = true;
                if (btn.dataset.option === q.correctStr) {
                    btn.classList.add('correct');
                } else if (btn === clickedBtn && !isCorrect) {
                    btn.classList.add('wrong');
                }
            });

            if (isCorrect) {
                state.streak += 1;
                state.totalSolved += 1;
                if (state.streak > state.bestStreak) state.bestStreak = state.streak;
                showFeedback(true, q);
                updatePracticeStatsUI();
                checkAchievements();
            } else {
                state.streak = 0;
                showFeedback(false, q);
                updatePracticeStatsUI();
            }
        }

        function showFeedback(isCorrect, q) {
            const box = document.getElementById('feedback-box');
            const title = document.getElementById('feedback-title');
            const rule = document.getElementById('feedback-rule');
            const steps = document.getElementById('feedback-steps');

            box.classList.remove('hidden', 'bg-emerald-950/70', 'border-emerald-500/40', 'bg-rose-950/70', 'border-rose-500/40');
            if (isCorrect) {
                box.classList.add('bg-emerald-950/70', 'border-emerald-500/40');
                title.textContent = 'Correct! Smooth sailing.';
                title.className = 'font-bold text-base text-emerald-300';
            } else {
                box.classList.add('bg-rose-950/70', 'border-rose-500/40');
                title.textContent = `Not quite — the correct image point is ${q.correctStr}.`;
                title.className = 'font-bold text-base text-rose-300';
            }

            rule.textContent = q.rule;
            steps.textContent = q.steps;
        }

        function hideFeedback() {
            document.getElementById('feedback-box').classList.add('hidden');
        }

        function nextQuestion() {
            loadNewQuestion();
        }

        function updatePracticeStatsUI() {
            document.getElementById('streak-value').textContent = state.streak;
            document.getElementById('best-streak-value').textContent = state.bestStreak;
            document.getElementById('total-solved-value').textContent = state.totalSolved;

            // Milestone progress bar
            let target = 10;
            let label = 'Next milestone: 10 (Challenge Mode)';
            if (state.streak >= 10 && state.streak < 20) {
                target = 20;
                label = 'Next milestone: 20 (Abyssal Navigator)';
            } else if (state.streak >= 20 && state.streak < 50) {
                target = 50;
                label = 'Next milestone: 50 (Mariana Trench Master)';
            } else if (state.streak >= 50) {
                target = 50;
                label = 'All Streak Milestones Mastered!';
            }

            const pct = Math.min(100, Math.round((state.streak / target) * 100));
            document.getElementById('milestone-label').textContent = label;
            document.getElementById('milestone-fraction').textContent = `${Math.min(state.streak, target)} / ${target}`;
            document.getElementById('milestone-bar').style.width = `${pct}%`;
        }

        /* =========================================================================
           6. ACHIEVEMENTS & CHALLENGE MODE UNLOCK
           ========================================================================= */

        function checkAchievements() {
            if (state.streak === 10 && !state.unlockedAchievements.has(10)) {
                state.unlockedAchievements.add(10);
                state.challengeUnlocked = true;

                const tab = document.getElementById('tab-challenge');
                tab.disabled = false;
                tab.textContent = 'Challenge Mode';
                tab.className = 'px-3.5 py-2 rounded-lg text-sm font-semibold bg-slate-800 text-slate-200 hover:bg-slate-700 transition-colors';

                const pill = document.getElementById('challenge-status-pill');
                pill.textContent = 'Challenge Unlocked';
                pill.className = 'text-xs font-medium px-2.5 py-1 rounded-full bg-teal-900/70 text-teal-200 border border-teal-500/40';

                openAchievementModal(
                    'Challenge Mode Unlocked!',
                    '10 correct answers in a row! You are now diving into Challenge Mode with decimals, non-origin rotations, and line reflections.',
                    true
                );
            } else if (state.streak === 20 && !state.unlockedAchievements.has(20)) {
                state.unlockedAchievements.add(20);
                openAchievementModal(
                    'Abyssal Navigator — 20 in a row!',
                    '20 consecutive correct transformations! Your coordinate instincts are razor sharp.',
                    false
                );
            } else if (state.streak === 50 && !state.unlockedAchievements.has(50)) {
                state.unlockedAchievements.add(50);
                openAchievementModal(
                    'Mariana Trench Master — 50 in a row!',
                    '50 consecutive correct answers! You have reached the deepest level of transformation mastery.',
                    false
                );
            }
        }

        let pendingSwitchToChallenge = false;

        function openAchievementModal(title, desc, autoSwitchChallenge) {
            pendingSwitchToChallenge = autoSwitchChallenge;
            document.getElementById('ach-title').textContent = title;
            document.getElementById('ach-desc').textContent = desc;
            const modal = document.getElementById('achievement-modal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
        }

        function closeAchievementModal() {
            const modal = document.getElementById('achievement-modal');
            modal.classList.add('opacity-0', 'pointer-events-none');
            if (pendingSwitchToChallenge) {
                pendingSwitchToChallenge = false;
                switchMode('challenge');
            }
        }

        /* =========================================================================
           7. GAME MODE: SUBMARINE DASH
           ========================================================================= */

        function renderGameReadyState() {
            document.getElementById('question-type-badge').textContent = '60-Second Timed Dive';
            document.getElementById('question-prompt').textContent = 'Ready to launch Submarine Dash?';
            document.getElementById('question-subtext').textContent = 'Press "Launch Submarine" on the left to start your 60-second descent.';
            document.getElementById('options-grid').innerHTML = '';
            document.getElementById('game-timer').textContent = '60s';
            document.getElementById('game-depth').textContent = '0m';
            document.getElementById('game-score').textContent = '0';
            document.getElementById('combo-badge').textContent = '1x Combo';
            document.getElementById('depth-bar').style.width = '0%';
            const btn = document.getElementById('game-action-btn');
            btn.textContent = 'Launch Submarine';
            btn.disabled = false;
        }

        function startSubmarineDash() {
            if (state.gameTimerId) clearInterval(state.gameTimerId);

            state.gameActive = true;
            state.gameTimeLeft = 60;
            state.gameScore = 0;
            state.gameDepth = 0;
            state.gameCombo = 1;

            updateGameStatsUI();

            const btn = document.getElementById('game-action-btn');
            btn.textContent = 'Dive in Progress...';
            btn.disabled = true;

            loadNewQuestion();

            state.gameTimerId = setInterval(() => {
                state.gameTimeLeft = Math.max(0, state.gameTimeLeft - 1);
                updateGameStatsUI();
                if (state.gameTimeLeft <= 0) {
                    stopSubmarineDash(true);
                }
            }, 1000);
        }

        function handleGameAnswer(isCorrect) {
            if (isCorrect) {
                const depthGain = 75 + (state.gameCombo - 1) * 25;
                const scoreGain = 100 * state.gameCombo;
                state.gameDepth += depthGain;
                state.gameScore += scoreGain;
                state.gameCombo = Math.min(5, state.gameCombo + 1);
            } else {
                state.gameCombo = 1;
                state.gameTimeLeft = Math.max(0, state.gameTimeLeft - 3);
            }

            updateGameStatsUI();

            if (state.gameTimeLeft <= 0) {
                stopSubmarineDash(true);
            } else {
                loadNewQuestion();
            }
        }

        function updateGameStatsUI() {
            document.getElementById('game-timer').textContent = `${state.gameTimeLeft}s`;
            document.getElementById('game-depth').textContent = `${state.gameDepth}m`;
            document.getElementById('game-score').textContent = state.gameScore;
            document.getElementById('combo-badge').textContent = `${state.gameCombo}x Combo`;
            const pct = Math.min(100, Math.round((state.gameDepth / 2000) * 100));
            document.getElementById('depth-bar').style.width = `${pct}%`;
        }

        function stopSubmarineDash(completed) {
            state.gameActive = false;
            if (state.gameTimerId) {
                clearInterval(state.gameTimerId);
                state.gameTimerId = null;
            }

            const btn = document.getElementById('game-action-btn');
            btn.textContent = 'Play Again';
            btn.disabled = false;

            if (completed) {
                document.getElementById('question-type-badge').textContent = 'Dive Complete';
                document.getElementById('question-prompt').textContent = `Submarine surfaced! Final Depth: ${state.gameDepth}m`;
                document.getElementById('question-subtext').textContent = `Final Score: ${state.gameScore} points. Click "Play Again" to beat your record!`;
                document.getElementById('options-grid').innerHTML = '';
            }
        }

        /* =========================================================================
           8. REFERENCE RULES MODAL & KEYBOARD SHORTCUT
           ========================================================================= */

        function openRulesModal() {
            document.getElementById('rules-modal').classList.remove('opacity-0', 'pointer-events-none');
        }

        function closeRulesModal() {
            document.getElementById('rules-modal').classList.add('opacity-0', 'pointer-events-none');
        }

        // Allow pressing Enter to advance to the next question after viewing feedback
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && state.awaitingNext && state.mode !== 'game') {
                nextQuestion();
            }
        });
    </script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Deep Ocean Transformations — Grade 8 Mapping Rules</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

        :root {
            --ocean-top: #061a2e;
            --ocean-mid: #0a2e4d;
            --ocean-deep: #041322;
            --panel-bg: rgba(11, 34, 58, 0.88);
            --panel-border: rgba(125, 211, 252, 0.16);
        }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(180deg, var(--ocean-top) 0%, var(--ocean-mid) 52%, var(--ocean-deep) 100%);
            color: #e2e8f0;
            min-height: 100vh;
            margin: 0;
            overflow-x: hidden;
        }

        /* Clean, crisp panels with no glowing text */
        .ocean-panel {
            background: var(--panel-bg);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid var(--panel-border);
            border-radius: 1rem;
            box-shadow: 0 12px 30px rgba(2, 10, 20, 0.45);
        }

        /* Background Swimming Fish Layer */
        #ocean-bg {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            overflow: hidden;
        }

        .fish-silhouette {
            position: absolute;
            opacity: 0.16;
            will-change: transform;
            animation-timing-function: linear;
            animation-iteration-count: infinite;
        }

        @keyframes swimRight {
            0% { transform: translateX(-180px); }
            100% { transform: translateX(calc(100vw + 180px)); }
        }

        @keyframes swimLeft {
            0% { transform: translateX(calc(100vw + 180px)) scaleX(-1); }
            100% { transform: translateX(-180px) scaleX(-1); }
        }

        @keyframes bubbleRise {
            0% { transform: translateY(105vh) scale(0.8); opacity: 0; }
            15% { opacity: 0.22; }
            85% { opacity: 0.18; }
            100% { transform: translateY(-10vh) scale(1.1); opacity: 0; }
        }

        .bubble {
            position: absolute;
            border-radius: 9999px;
            border: 1px solid rgba(186, 230, 253, 0.35);
            background: rgba(186, 230, 253, 0.08);
            animation-name: bubbleRise;
            animation-timing-function: linear;
            animation-iteration-count: infinite;
        }

        /* Pause all background animations cleanly */
        #ocean-bg.bg-paused * {
            animation-play-state: paused !important;
        }

        /* Option buttons */
        .option-btn {
            background: rgba(15, 48, 80, 0.9);
            border: 1px solid rgba(56, 189, 248, 0.35);
            color: #f1f5f9;
            transition: background-color 0.18s ease, border-color 0.18s ease, transform 0.15s ease;
        }
        .option-btn:hover:not(:disabled) {
            background: rgba(20, 72, 118, 0.95);
            border-color: rgba(56, 189, 248, 0.8);
            transform: translateY(-1px);
        }
        .option-btn:active:not(:disabled) {
            transform: translateY(0);
        }
        .option-btn.correct {
            background: rgba(6, 95, 70, 0.92);
            border-color: #34d399;
            color: #ecfdf5;
        }
        .option-btn.wrong {
            background: rgba(127, 29, 29, 0.92);
            border-color: #f87171;
            color: #fef2f2;
        }

        /* Submarine progress indicator */
        .sub-track {
            background: rgba(15, 42, 70, 0.9);
            border: 1px solid rgba(56, 189, 248, 0.25);
        }

        /* Smooth modal transitions */
        .modal-backdrop {
            transition: opacity 0.25s ease;
        }
    </style>
</head>
<body class="relative min-h-screen flex flex-col">

    <!-- Background Ocean Animation Layer -->
    <div id="ocean-bg" aria-hidden="true"></div>

    <!-- Opening Splash Screen -->
    <div id="splash-screen" class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-gradient-to-b from-[#041220] via-[#08243e] to-[#030e1a] transition-opacity duration-500">
        <div class="ocean-panel max-w-2xl w-full p-8 sm:p-12 text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-teal-900/60 border border-teal-500/30 mb-6">
                <svg class="w-9 h-9 text-teal-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 12c2.5-3.5 6-5.5 10-5.5s7.5 2 10 5.5c-2.5 3.5-6 5.5-10 5.5S4.5 15.5 2 12z"/>
                    <circle cx="15" cy="11" r="1.2" fill="currentColor"/>
                    <path d="M2 12l-1-3m1 3l-1 3"/>
                </svg>
            </div>
            <p class="text-xs font-semibold uppercase tracking-widest text-teal-300 mb-3">Grade 8 Coordinate Geometry</p>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-100 mb-6 tracking-tight">
                Deep Ocean Transformations
            </h1>
            <blockquote class="text-lg sm:text-xl text-slate-300 italic leading-relaxed mb-8 px-2">
                “In the deepest trenches of the ocean, the current shifts, mirrors, and turns every creature—yet no matter how far you translate or rotate, your true shape remains unchanged.”
            </blockquote>
            <button id="start-dive-btn" onclick="startApp()" class="px-8 py-3.5 rounded-xl bg-teal-600 hover:bg-teal-500 text-white font-semibold text-base sm:text-lg transition-colors shadow-lg w-full sm:w-auto">
                Start Dive
            </button>
        </div>
    </div>

    <!-- Main Application Shell -->
    <div id="app-shell" class="relative z-10 w-full max-w-5xl mx-auto px-4 sm:px-6 py-5 sm:py-8 flex-1 flex flex-col hidden opacity-0 transition-opacity duration-500">

        <!-- Top Navigation Bar -->
        <header class="ocean-panel p-4 mb-6 flex flex-col lg:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-sky-900/70 border border-sky-500/30 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6 text-sky-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 12h18M12 3v18"/>
                        <circle cx="16" cy="8" r="2" fill="currentColor"/>
                    </svg>
                </div>
                <div>
                    <h1 class="text-lg sm:text-xl font-bold text-slate-100 leading-tight">Deep Ocean Transformations</h1>
                    <p class="text-xs text-slate-400">Grade 8 Mapping Rules Practice</p>
                </div>
            </div>

            <!-- Mode Selector & Controls -->
            <div class="flex flex-wrap items-center justify-center gap-2">
                <button id="tab-standard" onclick="switchMode('standard')" class="px-3.5 py-2 rounded-lg text-sm font-semibold bg-sky-600 text-white transition-colors">
                    Standard
                </button>
                <button id="tab-challenge" onclick="switchMode('challenge')" disabled class="px-3.5 py-2 rounded-lg text-sm font-semibold bg-slate-800/80 text-slate-400 border border-slate-700 cursor-not-allowed transition-colors">
                    Challenge (10 Streak)
                </button>
                <button id="tab-game" onclick="switchMode('game')" class="px-3.5 py-2 rounded-lg text-sm font-semibold bg-slate-800 text-slate-200 hover:bg-slate-700 transition-colors">
                    Submarine Dash
                </button>

                <div class="hidden sm:block w-px h-7 bg-slate-700 mx-1"></div>

                <button onclick="openRulesModal()" class="px-3.5 py-2 rounded-lg text-sm font-medium bg-slate-800 hover:bg-slate-700 text-sky-200 border border-sky-700/50 transition-colors">
                    Mapping Rules
                </button>
                <button id="freeze-bg-btn" onclick="toggleBackgroundAnimation()" class="px-3.5 py-2 rounded-lg text-sm font-medium bg-teal-800/80 hover:bg-teal-700 text-teal-100 border border-teal-500/40 transition-colors flex items-center gap-1.5">
                    <span id="freeze-icon">⏸</span>
                    <span id="freeze-label">Freeze Background</span>
                </button>
            </div>
        </header>

        <!-- Main Content Grid -->
        <main class="grid grid-cols-1 lg:grid-cols-12 gap-6 flex-1">

            <!-- Left Sidebar: Stats & Progress -->
            <aside class="lg:col-span-4 flex flex-col gap-5">

                <!-- Practice Streak Panel -->
                <section id="practice-stats-panel" class="ocean-panel p-6">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Current Streak</span>
                        <span id="challenge-status-pill" class="text-xs font-medium px-2.5 py-1 rounded-full bg-slate-800 text-slate-300 border border-slate-700">
                            Challenge Locked
                        </span>
                    </div>

                    <div class="flex items-baseline gap-3 mb-4">
                        <span id="streak-value" class="text-5xl font-extrabold text-sky-300 tabular-nums">0</span>
                        <span class="text-sm text-slate-400">in a row</span>
                    </div>

                    <!-- Progress bar to next milestone -->
                    <div class="mb-4">
                        <div class="flex justify-between text-xs text-slate-400 mb-1.5">
                            <span id="milestone-label">Next milestone: 10 (Challenge Mode)</span>
                            <span id="milestone-fraction" class="font-semibold text-slate-300">0 / 10</span>
                        </div>
                        <div class="w-full h-2.5 rounded-full bg-slate-800 overflow-hidden">
                            <div id="milestone-bar" class="h-full bg-teal-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3 pt-4 border-t border-slate-700/70 text-center">
                        <div class="bg-slate-900/50 rounded-lg p-3">
                            <div class="text-xs text-slate-400 mb-0.5">Best Streak</div>
                            <div id="best-streak-value" class="text-xl font-bold text-slate-100 tabular-nums">0</div>
                        </div>
                        <div class="bg-slate-900/50 rounded-lg p-3">
                            <div class="text-xs text-slate-400 mb-0.5">Total Solved</div>
                            <div id="total-solved-value" class="text-xl font-bold text-slate-100 tabular-nums">0</div>
                        </div>
                    </div>
                </section>

                <!-- Submarine Dash Stats Panel (Visible only in Game Mode) -->
                <section id="game-stats-panel" class="ocean-panel p-6 hidden">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-xs font-semibold uppercase tracking-wider text-teal-300">Submarine Dash</span>
                        <span id="combo-badge" class="text-xs font-semibold px-2.5 py-1 rounded-full bg-sky-900/70 text-sky-200 border border-sky-600/40">
                            1x Combo
                        </span>
                    </div>

                    <div class="grid grid-cols-2 gap-3 mb-4">
                        <div class="bg-slate-900/60 rounded-xl p-3.5 text-center border border-slate-700/60">
                            <div class="text-xs text-slate-400 mb-1">Time Left</div>
                            <div id="game-timer" class="text-3xl font-extrabold text-amber-300 tabular-nums">60s</div>
                        </div>
                        <div class="bg-slate-900/60 rounded-xl p-3.5 text-center border border-slate-700/60">
                            <div class="text-xs text-slate-400 mb-1">Depth</div>
                            <div id="game-depth" class="text-3xl font-extrabold text-teal-300 tabular-nums">0m</div>
                        </div>
                    </div>

                    <div class="bg-slate-900/60 rounded-xl p-3.5 text-center border border-slate-700/60 mb-4">
                        <div class="text-xs text-slate-400 mb-1">Score</div>
                        <div id="game-score" class="text-2xl font-bold text-slate-100 tabular-nums">0</div>
                    </div>

                    <!-- Submarine Depth Visual -->
                    <div class="sub-track rounded-xl p-3 mb-4">
                        <div class="flex justify-between text-xs text-slate-400 mb-1.5">
                            <span>Surface (0m)</span>
                            <span>Abyss (2000m)</span>
                        </div>
                        <div class="w-full h-3 rounded-full bg-slate-900 overflow-hidden">
                            <div id="depth-bar" class="h-full bg-sky-400 rounded-full transition-all duration-300" style="width: 0%"></div>
                        </div>
                    </div>

                    <button id="game-action-btn" onclick="startSubmarineDash()" class="w-full py-3 rounded-xl bg-teal-600 hover:bg-teal-500 text-white font-semibold transition-colors">
                        Launch Submarine
                    </button>
                    <p class="text-xs text-slate-400 text-center mt-2.5">
                        Correct: +Depth &amp; Combo &bull; Wrong: -3s &amp; Reset Combo
                    </p>
                </section>

                <!-- Quick Tip Card -->
                <section class="ocean-panel p-5 text-sm text-slate-300">
                    <h2 class="text-sm font-bold text-sky-300 uppercase tracking-wider mb-2">Navigator's Tip</h2>
                    <p id="mode-tip-text" class="leading-relaxed text-slate-300">
                        In Standard Mode, apply the mapping rule carefully to both coordinates. Watch your negative signs when rotating clockwise around the origin!
                    </p>
                </section>
            </aside>

            <!-- Right Main Area: Question & Options -->
            <section class="lg:col-span-8 ocean-panel p-6 sm:p-8 flex flex-col justify-between">
                <div>
                    <!-- Question Header -->
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-6">
                        <span id="mode-badge" class="px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-sky-900/70 text-sky-200 border border-sky-600/40">
                            Standard Practice
                        </span>
                        <span id="question-type-badge" class="px-3 py-1 rounded-full text-xs font-medium bg-slate-800/90 text-slate-300 border border-slate-700">
                            Transformation
                        </span>
                    </div>

                    <!-- Question Prompt -->
                    <div id="question-container" class="mb-7">
                        <p id="question-prompt" class="text-xl sm:text-2xl font-bold text-slate-100 leading-snug mb-3">
                            Loading question...
                        </p>
                        <p id="question-subtext" class="text-sm text-slate-400">
                            Choose the correct image point from the 5 options below.
                        </p>
                    </div>

                    <!-- 5 Multiple Choice Options -->
                    <div id="options-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mb-6">
                        <!-- Dynamically populated -->
                    </div>
                </div>

                <!-- Feedback & Next Question Area -->
                <div id="feedback-box" class="hidden rounded-xl p-4 sm:p-5 border transition-all">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div class="space-y-1">
                            <div id="feedback-title" class="font-bold text-base"></div>
                            <div id="feedback-rule" class="text-sm font-medium text-sky-200"></div>
                            <div id="feedback-steps" class="text-sm text-slate-300"></div>
                        </div>
                        <button id="next-question-btn" onclick="nextQuestion()" class="px-5 py-2.5 rounded-lg bg-sky-600 hover:bg-sky-500 text-white font-semibold text-sm shrink-0 transition-colors">
                            Next Question →
                        </button>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <!-- Achievement Popup Modal -->
    <div id="achievement-modal" class="modal-backdrop fixed inset-0 z-50 bg-slate-950/75 flex items-center justify-center p-4 opacity-0 pointer-events-none">
        <div class="ocean-panel max-w-md w-full p-7 text-center border-teal-500/40">
            <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-amber-500/20 border border-amber-400/40 flex items-center justify-center text-3xl">
                🏆
            </div>
            <p class="text-xs font-semibold uppercase tracking-widest text-amber-300 mb-1">Achievement Unlocked</p>
            <h2 id="ach-title" class="text-2xl font-extrabold text-slate-100 mb-2">Challenge Mode Unlocked!</h2>
            <p id="ach-desc" class="text-sm text-slate-300 leading-relaxed mb-6">
                You reached 10 correct answers in a row! Switching you into Challenge Mode.
            </p>
            <button onclick="closeAchievementModal()" class="w-full py-3 rounded-xl bg-teal-600 hover:bg-teal-500 text-white font-semibold transition-colors">
                Continue Diving
            </button>
        </div>
    </div>

    <!-- Reference Rules Modal -->
    <div id="rules-modal" class="modal-backdrop fixed inset-0 z-50 bg-slate-950/75 flex items-center justify-center p-4 opacity-0 pointer-events-none">
        <div class="ocean-panel max-w-lg w-full p-6 sm:p-7 max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-700/80">
                <h2 class="text-lg font-bold text-slate-100">Grade 8 Mapping Rules Summary</h2>
                <button onclick="closeRulesModal()" class="text-slate-400 hover:text-slate-200 text-xl font-bold px-2">&times;</button>
            </div>
            <div class="space-y-4 text-sm text-slate-300">
                <div class="bg-slate-900/60 rounded-lg p-3.5 border border-slate-700/60">
                    <h3 class="font-bold text-sky-300 mb-1">Translations</h3>
                    <p><span class="font-semibold text-slate-100">(x, y) → (x + a, y + b)</span></p>
                    <p class="text-xs text-slate-400 mt-1">Positive <em>a</em> moves right, negative <em>a</em> moves left. Positive <em>b</em> moves up, negative <em>b</em> moves down.</p>
                </div>
                <div class="bg-slate-900/60 rounded-lg p-3.5 border border-slate-700/60">
                    <h3 class="font-bold text-sky-300 mb-1">Reflections</h3>
                    <ul class="space-y-1">
                        <li>Over the <strong>x-axis</strong>: <span class="font-semibold text-slate-100">(x, y) → (x, −y)</span></li>
                        <li>Over the <strong>y-axis</strong>: <span class="font-semibold text-slate-100">(x, y) → (−x, y)</span></li>
                        <li class="text-xs text-slate-400 pt-1">Challenge: Over <em>x = c</em> → (2c − x, y); Over <em>y = c</em> → (x, 2c − y)</li>
                    </ul>
                </div>
                <div class="bg-slate-900/60 rounded-lg p-3.5 border border-slate-700/60">
                    <h3 class="font-bold text-sky-300 mb-1">Clockwise Rotations (Around Origin)</h3>
                    <ul class="space-y-1">
                        <li><strong>90° clockwise</strong>: <span class="font-semibold text-slate-100">(x, y) → (y, −x)</span></li>
                        <li><strong>180° clockwise</strong>: <span class="font-semibold text-slate-100">(x, y) → (−x, −y)</span></li>
                        <li><strong>270° clockwise</strong>: <span class="font-semibold text-slate-100">(x, y) → (−y, x)</span></li>
                        <li class="text-xs text-slate-400 pt-1">Challenge: Around (h, k), shift by (−h, −k), rotate, then shift back by (+h, +k).</li>
                    </ul>
                </div>
            </div>
            <button onclick="closeRulesModal()" class="mt-5 w-full py-2.5 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-semibold transition-colors">
                Close Guide
            </button>
        </div>
    </div>

    <script>
        /* =========================================================================
           1. CORE MATH & FORMATTING HELPERS (Bug-Free Coordinate Handling)
           ========================================================================= */

        /**
         * Eliminates floating-point noise and negative zero (-0).
         */
        function cleanNum(n) {
            const r = Math.round(n * 100) / 100;
            return Object.is(r, -0) || r === 0 ? 0 : r;
        }

        /**
         * Formats a coordinate pair consistently as "(x, y)".
         */
        function formatPoint(x, y) {
            return `(${cleanNum(x)}, ${cleanNum(y)})`;
        }

        /**
         * Formats a signed offset for mapping rule notation, e.g. "x - 4" or "y + 3".
         */
        function formatShiftExpr(varName, delta) {
            const d = cleanNum(delta);
            return d >= 0 ? `${varName} + ${d}` : `${varName} - ${Math.abs(d)}`;
        }

        function randInt(min, max) {
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        function pickRandom(arr) {
            return arr[Math.floor(Math.random() * arr.length)];
        }

        function shuffle(arr) {
            const copy = [...arr];
            for (let i = copy.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [copy[i], copy[j]] = [copy[j], copy[i]];
            }
            return copy;
        }

        /**
         * Non-zero integer in [-max..-1, 1..max].
         */
        function randNonZeroInt(max) {
            const vals = [];
            for (let i = -max; i <= max; i++) {
                if (i !== 0) vals.push(i);
            }
            return pickRandom(vals);
        }

        /**
         * Non-zero 0.5-step value in [-max..-0.5, 0.5..max].
         */
        function randNonZeroHalfStep(max) {
            const vals = [];
            for (let i = -max * 2; i <= max * 2; i++) {
                if (i !== 0) vals.push(cleanNum(i / 2));
            }
            return pickRandom(vals);
        }

        /**
         * Generates a 0.5-step coordinate in [-max..max].
         */
        function randHalfStep(max) {
            return cleanNum(randInt(-max * 2, max * 2) / 2);
        }

        /* =========================================================================
           2. APPLICATION STATE
           ========================================================================= */

        const state = {
            mode: 'standard', // 'standard' | 'challenge' | 'game'
            streak: 0,
            bestStreak: 0,
            totalSolved: 0,
            challengeUnlocked: false,
            unlockedAchievements: new Set(),
            bgPaused: false,
            currentQuestion: null,
            awaitingNext: false,
            // Submarine Dash game state
            gameActive: false,
            gameTimeLeft: 60,
            gameScore: 0,
            gameDepth: 0,
            gameCombo: 1,
            gameTimerId: null
        };

        /* =========================================================================
           3. BACKGROUND FISH & BUBBLES ANIMATION
           ========================================================================= */

        function initOceanBackground() {
            const container = document.getElementById('ocean-bg');
            container.innerHTML = '';

            // Subtle SVG fish silhouettes
            const fishPaths = [
                `<svg viewBox="0 0 120 50" fill="#7dd3fc"><path d="M95 25c-15-16-42-22-68-12L8 4l7 21-7 21 19-9c26 10 53 4 68-12 7-5 14-2 17 0-3-2-10 5-17 0z"/></svg>`,
                `<svg viewBox="0 0 100 44" fill="#5eead4"><path d="M84 22C70 8 44 6 24 15L4 6l8 16-8 16 20-9c20 9 46 7 60-7z"/></svg>`,
                `<svg viewBox="0 0 140 56" fill="#38bdf8"><path d="M120 28c-18-18-50-24-82-12L10 5l10 23-10 23 28-11c32 12 64 6 82-12z"/></svg>`
            ];

            for (let i = 0; i < 8; i++) {
                const el = document.createElement('div');
                el.className = 'fish-silhouette';
                el.innerHTML = fishPaths[i % fishPaths.length];

                const goRight = i % 2 === 0;
                const width = randInt(58, 120);
                el.style.width = `${width}px`;
                el.style.top = `${randInt(8, 86)}vh`;
                el.style.animationName = goRight ? 'swimRight' : 'swimLeft';
                el.style.animationDuration = `${randInt(26, 48)}s`;
                el.style.animationDelay = `-${randInt(0, 40)}s`;
                container.appendChild(el);
            }

            // Gentle rising bubbles
            for (let i = 0; i < 12; i++) {
                const b = document.createElement('div');
                b.className = 'bubble';
                const size = randInt(6, 16);
                b.style.width = `${size}px`;
                b.style.height = `${size}px`;
                b.style.left = `${randInt(4, 96)}vw`;
                b.style.animationDuration = `${randInt(14, 28)}s`;
                b.style.animationDelay = `-${randInt(0, 24)}s`;
                container.appendChild(b);
            }
        }

        function toggleBackgroundAnimation() {
            state.bgPaused = !state.bgPaused;
            const bg = document.getElementById('ocean-bg');
            const icon = document.getElementById('freeze-icon');
            const label = document.getElementById('freeze-label');
            const btn = document.getElementById('freeze-bg-btn');

            if (state.bgPaused) {
                bg.classList.add('bg-paused');
                icon.textContent = '▶';
                label.textContent = 'Resume Background';
